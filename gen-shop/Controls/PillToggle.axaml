<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GenShop.Controls.PillToggle"
             x:Name="Root">
  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
    <Border x:Name="Track"
            Width="42"
            Height="24"
            CornerRadius="12"
            Background="#3A4458"
            Cursor="Hand"
            VerticalAlignment="Center">
      <Border x:Name="Knob"
              Width="18"
              Height="18"
              CornerRadius="9"
              Background="White"
              HorizontalAlignment="Left"
              Margin="3,0"
              VerticalAlignment="Center" />
    </Border>
    <TextBlock x:Name="Caption"
               VerticalAlignment="Center"
               FontSize="15"
               Foreground="#E7ECF5" />
  </StackPanel>
</UserControl>
